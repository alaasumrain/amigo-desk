# Production Environment Variables
# Copy this to .env.production on your VPS and fill in the values

# Domain and SSL
DOMAIN=desk.yourdomain.com
FRONTEND_URL=https://desk.yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Rails
RAILS_ENV=production
SECRET_KEY_BASE=GENERATE_WITH_openssl_rand_hex_64

# Database (strong passwords required)
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
REDIS_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

# Email Configuration (required for production)
MAILER_SENDER_EMAIL=Amigo Desk <support@yourdomain.com>
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_DOMAIN=yourdomain.com

# Security
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=true

# Optional: WhatsApp Business
# WHATSAPP_CLOUD_VERIFY_TOKEN=your_verify_token
# WHATSAPP_CLOUD_ACCESS_TOKEN=your_access_token
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=your_phone_number_id

# Optional: Storage (uncomment for S3)
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=your-bucket
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_REGION=us-east-1

# Optional: Monitoring
# SENTRY_DSN=your_sentry_dsn